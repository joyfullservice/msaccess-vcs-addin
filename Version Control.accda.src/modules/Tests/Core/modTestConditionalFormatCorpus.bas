Attribute VB_Name = "modTestConditionalFormatCorpus"
'---------------------------------------------------------------------------------------
' Module    : modTestConditionalFormatCorpus
' Author    : Adam Waller
' Date      : 7/28/2026
' Purpose   : Captured conditional-format corpus - the exact CF14 and legacy hex blocks
'           : Access SaveAsText wrote for 42 controls covering every rule shape the
'           : add-in handles. Both blocks must rebuild byte-for-byte from the decoded
'           : model, which makes this the regression net for clsConditionalFormat.
'           :
'           : Every rule here was authored with VBA FormatConditions.Add. Access stores
'           : a Boolean it copies from VBA as VBA True (&HFF), while the design-view
'           : dialog stores 1 for the same flag - both are valid and Access preserves
'           : whichever it finds. The emitter targets the VBA encoding; see
'           : modTestConditionalFormat.TestAlternateBooleanEncoding for the other one,
'           : and docs/access-conditional-format.md section 6 for the full rule.
'           :
'           : Generated from captures rather than transcribed: hand-copying hex is what
'           : silently corrupted an earlier fixture into an odd-length string.
'---------------------------------------------------------------------------------------
Option Compare Database
Option Explicit
Option Private Module
'@Folder("Tests.Core")
'@Tag("unit")


'---------------------------------------------------------------------------------------
' Procedure : TestCorpusCF14ByteExact
' Purpose   : Every captured CF14 block rebuilds byte-for-byte from its decoded model.
'           : CF14 is the authoritative block, so a failure here means real formatting
'           : loss for the shape named in the assertion.
'---------------------------------------------------------------------------------------
'
Public Sub TestCorpusCF14ByteExact()

    Dim varEntry As Variant
    Dim cCF As clsConditionalFormat

    For Each varEntry In Corpus
        Set cCF = New clsConditionalFormat
        TestAssert cCF.LoadFromCF14Hex(CStr(varEntry(1))), "decodes: " & varEntry(0)
        TestAssert cCF.BuildCF14Hex() = CStr(varEntry(1)), "CF14 byte-exact: " & varEntry(0)
    Next varEntry

End Sub


'---------------------------------------------------------------------------------------
' Procedure : TestCorpusLegacyByteExact
' Purpose   : Every captured legacy block rebuilds byte-for-byte. A malformed legacy
'           : block is not benign - Access silently discards the legacy blocks of every
'           : control on the form when one of them is bad.
'           :
'           : An empty expectation means Access wrote no legacy block at all, which is
'           : correct for a control whose rules the single-type legacy block cannot
'           : represent (data-bar-only controls).
'---------------------------------------------------------------------------------------
'
Public Sub TestCorpusLegacyByteExact()

    Dim varEntry As Variant
    Dim cCF As clsConditionalFormat

    For Each varEntry In Corpus
        Set cCF = New clsConditionalFormat
        cCF.LoadFromCF14Hex CStr(varEntry(1))
        TestAssert cCF.BuildLegacyHex() = CStr(varEntry(2)), "legacy byte-exact: " & varEntry(0)
    Next varEntry

End Sub


'---------------------------------------------------------------------------------------
' Procedure : TestCorpusRebuildIsIdempotent
' Purpose   : Decoding a rebuilt block and rebuilding again yields identical bytes, so a
'           : repeated export/import cycle cannot drift.
'---------------------------------------------------------------------------------------
'
Public Sub TestCorpusRebuildIsIdempotent()

    Dim varEntry As Variant
    Dim cCF As clsConditionalFormat
    Dim strPass1 As String

    For Each varEntry In Corpus
        Set cCF = New clsConditionalFormat
        cCF.LoadFromCF14Hex CStr(varEntry(1))
        strPass1 = cCF.BuildCF14Hex()
        Set cCF = New clsConditionalFormat
        cCF.LoadFromCF14Hex strPass1
        TestAssert cCF.BuildCF14Hex() = strPass1, "rebuild idempotent: " & varEntry(0)
    Next varEntry

End Sub


' ===================================================================================
' Captured corpus (helpers are parameterized, so not discovered as tests)
' ===================================================================================

'---------------------------------------------------------------------------------------
' Procedure : Corpus
' Purpose   : All captured controls as Array(label, cf14Hex, legacyHex).
'---------------------------------------------------------------------------------------
'
Private Function Corpus() As Collection

    Dim colAll As Collection

    Set colAll = New Collection
    CaptureDataBars colAll
    CaptureExpressions colAll
    CaptureMultiRule colAll
    CaptureFieldValues colAll
    CaptureFontFlags colAll
    Set Corpus = colAll

End Function


Private Sub Capture(colAll As Collection, strLabel As String, strCF14 As String, _
    strLegacy As String)
    colAll.Add Array(strLabel, strCF14, strLegacy)
End Sub


