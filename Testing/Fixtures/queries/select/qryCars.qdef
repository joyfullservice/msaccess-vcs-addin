dbMemo "SQL" ="SELECT DISTINCT\015\012  tblCars.Manufacturer,\015\012  tblCars.Year,"
    "\015\012  tblCarsModel.Model,\015\012  tblCarsColour.Colour,\015\012  "
    "tblCarsPrice.Price\015\012FROM\015\012  ((tblCars\015\012  INNER JOIN "
    "tblCarsModel ON tblCars.ID = tblCarsModel.ID)\015\012  INNER JOIN tblC"
    "arsColour ON tblCarsModel.ID = tblCarsColour.ID)\015\012  INNER JOIN t"
    "blCarsPrice ON tblCarsColour.ID = tblCarsPrice.ID;\015\012"
