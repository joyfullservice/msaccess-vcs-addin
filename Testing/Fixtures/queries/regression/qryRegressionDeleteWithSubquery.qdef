dbMemo "SQL" ="DELETE\015\012  tblCars.*\015\012FROM\015\012  tblCars\015\012WHERE"
    "\015\012  Exists (\015\012    SELECT\015\012      1\015\012    FROM"
    "\015\012      tblVehicles\015\012    WHERE\015\012      tblVehicles.Ma"
    "nufacturer = tblCars.Manufacturer\015\012  ) = False;\015\012"
